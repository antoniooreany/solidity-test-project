{
  "name": "solidity-test-project",
  "version": "1.0.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "lint:js": "eslint .",
    "lint": "npm run format:check && npm run lint:sol && npm run lint:js",
    "lint:fix": "prettier --write . && eslint --fix ."
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "ethers": "^6.17.0",
    "globals": "^17.12.0",
    "hardhat": "^3.14.0",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.1",
    "solhint": "^6.2.4"
  },
  "type": "module"
}
